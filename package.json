{
    "name": "@inluxc/stagehand",
    "version": "1.0.0",
    "description": "Extensible fixture toolkit for Playwright Test — adds OpenAPI, database, Kafka, Redis, Neo4j, Appium (mobile, incl. GADS device farms), and OTP fixtures on top of @playwright/test",
    "type": "module",
    "bin": {
        "stagehand": "dist/src/cli/init.js"
    },
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js",
            "default": "./dist/src/index.js"
        },
        "./config": {
            "types": "./dist/src/config/index.d.ts",
            "import": "./dist/src/config/index.js"
        },
        "./fixtures": {
            "types": "./dist/src/fixtures/index.d.ts",
            "import": "./dist/src/fixtures/index.js"
        },
        "./secrets": {
            "types": "./dist/src/secrets/index.d.ts",
            "import": "./dist/src/secrets/index.js"
        },
        "./errors": {
            "types": "./dist/src/errors.d.ts",
            "import": "./dist/src/errors.js"
        },
        "./cli": {
            "types": "./dist/src/cli/init.d.ts",
            "import": "./dist/src/cli/init.js"
        }
    },
    "files": [
        "dist/src",
        "README.md",
        "LICENSE",
        "environments.json"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "rm -rf dist",
        "prebuild": "npm run clean",
        "prepublishOnly": "npm run build",
        "release": "npm run build && npm publish --access public",
        "release:dry": "npm run build && npm publish --dry-run --access public",
        "test": "npx playwright test",
        "test:tag": "npx playwright test --grep",
        "typecheck": "tsc --noEmit",
        "lint:tests": "tsx src/cli/init.ts check",
        "next-id": "tsx src/cli/init.ts next-id",
        "verify": "npm run typecheck && npm run lint:tests && npx playwright test --project=unit-tests --project=property-tests",
        "docs:dev": "npm --prefix docs ci && npm --prefix docs run dev",
        "docs:build": "npm --prefix docs ci && npm --prefix docs run build"
    },
    "dependencies": {
        "better-sqlite3": "^13.2.0",
        "dotenv": "^18.0.10",
        "graphql": "^16.15.0",
        "graphql-request": "^7.4.0",
        "ioredis": "^6.0.0",
        "kafkajs": "^2.2.4",
        "mongodb": "^7.9.1",
        "mssql": "^12.7.16",
        "mysql2": "^3.24.6",
        "neo4j-driver": "^6.3.2",
        "openapi-client-axios": "^7.9.1",
        "otplib": "^13.6.0",
        "pg": "^8.23.1",
        "webdriverio": "^9.33.1"
    },
    "peerDependencies": {
        "@playwright/test": ">=1.50.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@stoplight/prism-cli": "5.16.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/mssql": "^12.3.0",
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "fast-check": "^4.10.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "keywords": [
        "playwright",
        "playwright-test",
        "fixtures",
        "testing",
        "api",
        "openapi",
        "database",
        "mongodb",
        "neo4j",
        "kafka",
        "redis",
        "mobile",
        "appium",
        "gads",
        "otp",
        "integration",
        "extension",
        "stagehand"
    ],
    "author": "Inluxc",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Inluxc/stagehand.git"
    },
    "homepage": "https://github.com/Inluxc/stagehand#readme",
    "bugs": {
        "url": "https://github.com/Inluxc/stagehand/issues"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
